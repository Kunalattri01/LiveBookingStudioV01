
# Database - defaults to SQLite so the project runs immediately with
# no setup. Set DB_ENGINE=mssql (plus the other DB_* values below) if
# you want to point this at a local SQL Server instance instead.
DB_ENGINE=sqlite3
DB_NAME=Booking_Test
DB_HOST=
DB_PORT=
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUSTED_CONNECTION=yes
