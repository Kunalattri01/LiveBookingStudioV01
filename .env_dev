# Local development settings
DJANGO_SECRET_KEY=replace-with-a-local-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Shared platform settings
DEFAULT_CURRENCY=INR
FRONTEND_PAGE_SIZE=20
DB_ENGINE=mssql

# TripJack. Keep the real key only in your local .env file.
TRIPJACK_API_KEY=513553d8379acd-cfd0-431e-999c-9a2df5042183
TRIPJACK_BASE_URL=https://apitest.tripjack.com
TRIPJACK_ENV=test
TRIPJACK_TIMEOUT_SECONDS=22
# 13.127.119.170
TRIPJACK_INCLUDE_DIRECT_FLIGHTS=True
TRIPJACK_INCLUDE_CONNECTING_FLIGHTS=True
FLIGHT_PROVIDER=tripjack

# Hotel (TripJack Hotel API v3) - reuses TRIPJACK_API_KEY above.
# Set to "tripjack" for live TripJack calls, or "mock" to demo the
# full funnel with frozen real data while TripJack's UAT sandbox has
# no stable live inventory (see hotel/providers/mock_provider.py).
HOTEL_PROVIDER=tripjack
HOTEL_HMS_BASE_URL=https://apitest-hms.tripjack.com
HOTEL_BOOKER_BASE_URL=https://apitest.tripjack.com